---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<div class="bg-white rounded-[28px] sm:rounded-[32px] p-7 sm:p-9 lg:p-10 shadow-[0_16px_40px_-8px_rgba(0,48,133,0.14)] border border-slate-100/80 flex flex-col items-center text-center transition-all duration-300 hover:shadow-[0_20px_50px_-8px_rgba(0,48,133,0.18)]">
  <div class="mb-4 sm:mb-5 flex justify-center items-center">
    <img 
      src={icon} 
      alt={`Icono de ${title}`} 
      class="w-16 h-16 sm:w-20 sm:h-20 object-contain"
    />
  </div>
  <h3 class="font-['Nunito'] font-extrabold text-[#003085] text-2xl sm:text-3xl mb-3 sm:mb-4 tracking-tight">
    {title}
  </h3>
  <p class="font-['Poppins'] text-slate-700 text-sm sm:text-[15px] lg:text-base leading-relaxed sm:leading-loose text-center max-w-lg">
    {description}
  </p>
</div>
