---
import ServiceInfoItem from "./ServiceInfoItem.astro";
import ServiceLocationCard from "./ServiceLocationCard.astro";
import ServiceFeatureItem from "./ServiceFeatureItem.astro";

interface LocationData {
  nombre: string;
  detalle: string;
}

interface FeatureData {
  texto: string;
  // Lista con viñetas debajo del texto (opcional)
  procedimientos?: string[];
  // Párrafo final debajo de la lista (opcional)
  nota?: string;
}

interface Props {
  title: string;
  cornerImage: string;
  directedTo: string;
  locations: LocationData[];
  features: FeatureData[];
}

const { title, cornerImage, directedTo, locations, features } = Astro.props;

// Grid de features: 1 col por defecto, 2 si hay 2, 3 si hay 3+
const featureGrid =
  features.length === 1
    ? "grid-cols-1 md:max-w-[80%]"
    : features.length === 2
      ? "grid-cols-1 md:grid-cols-2 md:gap-x-[6%]"
      : "grid-cols-1 md:grid-cols-2 lg:grid-cols-3 lg:gap-x-12";
---

<section class="w-full overflow-hidden">
  <!-- Hero: título + info + tarjeta de sedes, con imagen en arco arriba a la derecha -->
  <div class="relative w-full">
    <!-- Imagen: arco elíptico (esquina inferior izquierda redondeada al 100%) -->
    <div
      class="relative z-0 ml-auto w-[72%] aspect-[1.37] rounded-bl-[100%] overflow-hidden md:absolute md:top-0 md:right-0 md:w-[48%]"
    >
      <img
        src={cornerImage}
        alt=""
        aria-hidden="true"
        class="h-full w-full object-cover object-center"
      />
    </div>

    <div class="relative z-10 w-full px-6 pt-4 pb-8 md:w-[56%] md:pl-[8%] md:pr-[2%] md:pt-14 lg:pt-20 md:pb-12">
      <h1
        class="font-['Nunito'] text-[#12458c] font-extrabold text-5xl lg:text-7xl leading-[1.05] max-w-[8.2em] md:pl-[3%] mb-8 lg:mb-10"
      >
        {title}
      </h1>

      <!-- Fila: Dirigido | divisor | Disponible en -->
      <div class="flex flex-wrap lg:flex-nowrap items-center gap-x-4 gap-y-3 mb-6 lg:mb-8">
        <ServiceInfoItem icon="/servicios/icon-2.webp" text={`Dirigido: ${directedTo}`} />
        <div class="hidden sm:block w-px self-stretch bg-[#12458c]/50" aria-hidden="true"></div>
        <ServiceInfoItem icon="/servicios/icon-1.webp" text="Disponible en" />
      </div>

      <ServiceLocationCard locations={locations} />
    </div>
  </div>

  <!-- Sección Características del Servicio -->
  <div class="px-6 md:px-[3.5%] pt-6 pb-16 lg:pb-24">
    <h2
      class="font-['Nunito'] text-[#12458c] font-bold text-3xl lg:text-5xl md:pl-[7%] mb-8 lg:mb-12"
    >
      Características del Servicio
    </h2>

    <div class={`grid ${featureGrid} gap-y-10 items-start`}>
      {features.map((feature) => (
        <ServiceFeatureItem
          texto={feature.texto}
          procedimientos={feature.procedimientos}
          nota={feature.nota}
          justify={features.length < 3}
        />
      ))}
    </div>
  </div>
</section>
