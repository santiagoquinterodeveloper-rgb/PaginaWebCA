import Layout from "../../layouts/Layout.astro";

const RADICA_URL =
  "https://t.almeraim.com/form?data=eyJhcGlrZXkiOiJCQjMxMUY1ODRCQTNCNkZFNUQzRDBCMEFEQjEzQTkzOUU2RjYyRTFEMjY3M0E2NDBFMzY5MkY1QjNCQUNBQjcwIiwiY29ubmVjdGlvbiI6InNnaWNsaW5pY2FhbnRpb3F1aWEiLCJlbmRwb2ludCI6Imh0dHBzJTNBJTJGJTJGc2dpLmFsbWVyYWltLmNvbSUyRnNnaSUyRmFwaSUyRnYyJTJGIiwiY29kZSI6IlFSU0YifQ==";
const SEGUIMIENTO_URL =
  "https://t.almeraim.com/form/view?data=eyJhcGlrZXkiOiJCQjMxMUY1ODRCQTNCNkZFNUQzRDBCMEFEQjEzQTkzOUU2RjYyRTFEMjY3M0E2NDBFMzY5MkY1QjNCQUNBQjcwIiwiY29ubmVjdGlvbiI6InNnaWNsaW5pY2FhbnRpb3F1aWEiLCJlbmRwb2ludCI6Imh0dHBzJTNBJTJGJTJGc2dpLmFsbWVyYWltLmNvbSUyRnNnaSUyRmFwaSUyRnYyJTJGIiwiY29kZSI6IlFSU0YifQ%3D%3D";

const buttonClasses =
  "inline-flex items-center justify-center rounded-full bg-[#1c4482] px-8 sm:px-10 py-3 sm:py-3.5 text-base sm:text-lg font-medium text-white shadow-sm transition-colors hover:bg-[#15335f] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2990cb]";
---

<Layout
  title="Gestión de PQRS | Clínica Antioquia"
  description="Radica y haz seguimiento a tus peticiones, quejas, reclamos, sugerencias y felicitaciones en Clínica Antioquia."
>
  <main class="relative w-full overflow-x-hidden bg-white">
    <!-- SECCIÓN 1 — Gestión de PQRS -->
    <section
      class="relative w-full bg-cover bg-center bg-no-repeat"
      style="background-image: url('/pacientes-visitantes/gestion-de-pqrs/Fondo-gestion-pqr.webp');"
    >
      <div
        class="relative z-10 w-full max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 pt-8 sm:pt-10 lg:pt-12"
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10 lg:gap-14 items-end">
          <!-- Texto + botón -->
          <div class="flex flex-col justify-center space-y-5 sm:space-y-6 pb-10 md:pb-14 lg:pb-16">
            <h1
              class="font-nunito font-extrabold text-4xl sm:text-5xl lg:text-6xl text-[#1c4482] leading-[1.1] tracking-tight"
            >
              Gestión de PQRS
            </h1>

            <div
              class="space-y-4 text-base sm:text-lg text-black leading-relaxed max-w-xl"
            >
              <p>
                Señor usuario, recuerde que Clínica Antioquia cuenta con un
                tiempo de respuesta establecido. De no obtener respuesta por
                parte de la entidad podrá elevar una PQR ante la
                Superintendencia Nacional de Salud.
              </p>
              <p>
                La finalidad de la información suministrada en este formulario
                es solo para tramitar su Solicitud, Sugerencia, Felicitación u
                Oportunidad de mejora reportada a la Clínica Antioquia.
                Autorizo a Clínica Antioquia a realizar tratamiento de mis
                Datos personales.
              </p>
            </div>

            <div>
              <a
                href={RADICA_URL}
                target="_blank"
                rel="noopener noreferrer"
                class={buttonClasses}
              >
                Radica tu PQRS
              </a>
            </div>
          </div>

          <!-- Imagen chica: oculta en mobile, visible desde md -->
          <div class="hidden md:flex items-end justify-center lg:justify-end">
            <img
              src="/pacientes-visitantes/gestion-de-pqrs/img-gestion-pqr-10.webp"
              alt="Asesora de Clínica Antioquia"
              class="w-auto max-w-sm lg:max-w-none md:h-[420px] lg:h-[500px] xl:h-[540px] object-contain object-bottom block"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 2 — Seguimiento de PQRS + NOTA -->
    <section class="relative w-full bg-white">
      <!-- Flor decorativa: esquina inferior derecha, detrás del contenido -->
      <img
        src="/pacientes-visitantes/gestion-de-pqrs/img-gestion-pqr-11.webp"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute bottom-0 right-0 z-0 w-56 sm:w-72 md:w-96 lg:w-[28rem] xl:w-[32rem] h-auto select-none"
      />

      <div
        class="relative z-10 w-full max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 pt-10 sm:pt-12 lg:pt-14 pb-16 sm:pb-20 lg:pb-24"
      >
        <div class="flex flex-col space-y-5 sm:space-y-6 max-w-3xl">
          <h2
            class="font-nunito font-extrabold text-4xl sm:text-5xl lg:text-6xl text-[#1c4482] leading-[1.1] tracking-tight"
          >
            Seguimiento de PQRS
          </h2>

          <div
            class="space-y-4 text-base sm:text-lg text-black leading-relaxed"
          >
            <p>
              Ingrese por el ícono seguimiento a su PQRS y en tipo marque
              gestión de quejas, reclamos, sugerencias y felicitaciones, digite
              el código del trámite y el documento de identificación.
            </p>
            <p>
              Cada manifestación registrada tiene un estado de cumplimiento,
              los cuales son: nuevo, pendiente por respuesta, respuesta emitida
              y cerrado.
            </p>
            <p>
              Tenga en cuenta los tiempos que tiene la clínica para dar
              respuesta a su manifestación, los cuales son:
            </p>
          </div>

          <div>
            <a
              href={SEGUIMIENTO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class={buttonClasses}
            >
              Seguimiento a PRQS
            </a>
          </div>
        </div>

        <!-- Bloque NOTA -->
        <div class="mt-12 sm:mt-14 lg:mt-16 max-w-3xl">
          <h3
            class="font-nunito font-extrabold text-xl sm:text-2xl text-[#1c4482] mb-3"
          >
            NOTA:
          </h3>

          <div
            class="rounded-2xl border-2 border-[#1c4482] bg-white/90 backdrop-blur-sm px-5 sm:px-7 py-5 sm:py-6 space-y-4"
          >
            <p class="text-base sm:text-lg text-black leading-relaxed">
              Recuerde que además disponemos de oficinas de Atención Centrada
              en la Persona en cada sede, donde también podemos dar respuesta a
              sus solicitudes o puede comunicarse con nosotros en los
              teléfonos:
            </p>

            <ul class="space-y-3 text-sm sm:text-base text-black">
              <li class="flex flex-wrap items-center gap-x-2 gap-y-2">
                <img
                  src="/pacientes-visitantes/gestion-de-pqrs/icon-gestion-de-pqrs-1.webp"
                  alt=""
                  aria-hidden="true"
                  class="h-5 w-5 sm:h-6 sm:w-6 object-contain shrink-0"
                />
                <span>Itagüí: 322 22 11</span>
                <img
                  src="/pacientes-visitantes/gestion-de-pqrs/icon-gestion-de-pqrs-2.webp"
                  alt=""
                  aria-hidden="true"
                  class="h-5 w-5 sm:h-6 sm:w-6 object-contain shrink-0"
                />
                <span>316 834 73 21</span>
              </li>
              <li class="flex flex-wrap items-center gap-x-2 gap-y-2">
                <img
                  src="/pacientes-visitantes/gestion-de-pqrs/icon-gestion-de-pqrs-1.webp"
                  alt=""
                  aria-hidden="true"
                  class="h-5 w-5 sm:h-6 sm:w-6 object-contain shrink-0"
                />
                <span>Bello: 322 22 11</span>
                <img
                  src="/pacientes-visitantes/gestion-de-pqrs/icon-gestion-de-pqrs-2.webp"
                  alt=""
                  aria-hidden="true"
                  class="h-5 w-5 sm:h-6 sm:w-6 object-contain shrink-0"
                />
                <span>318 516 35 82</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
