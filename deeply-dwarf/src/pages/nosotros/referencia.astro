---
import Layout from "../../layouts/Layout.astro";

const FORMULARIO_URL =
  "https://e.almeraim.com/survey?data=eyJhcGlrZXkiOiIyNWY3YjJmYzg1YTljMDMyYzZjNGYwY2UwZmVlNzI3YTE3NDMwNmY5Y2Y1NDEwMzQ3ZjdhNTk1MDE4MWY2Yzg1IiwiY29ubmVjdGlvbiI6InNnaWNsaW5pY2FhbnRpb3F1aWEiLCJlbmRwb2ludCI6Imh0dHBzJTNBJTJGJTJGc2dpLmFsbWVyYWltLmNvbSUyRnNnaSUyRmFwaSUyRnYyJTJGIiwiY29kZSI6IkdDIn0=";
---

<Layout
  title="Referenciación | Clínica Antioquia"
  description="En Clínica Antioquia realizamos referenciaciones comparativas para adoptar mejores prácticas. Completa el formulario si deseas hacer una en nuestra institución."
>
  <main class="relative flex flex-col justify-end w-full lg:min-h-[calc(100vh-72px)] overflow-hidden bg-white">
    <!-- Fondo: foto con velo blanco-azulado -->
    <img
      src="/nosotros/referencia/img 01- referenciacion.webp"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-top z-0"
    />
    <div class="absolute inset-0 z-0 bg-white/70"></div>
    <img
      src="/trabaja-con-nosotros/florGigante.webp"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute top-1/2 -left-[22%] -translate-y-1/2 w-[55%] max-w-none z-0 opacity-80"
    />

    <!-- Contenido -->
    <div
      class="relative z-10 w-full max-w-[1600px] mx-auto px-6 sm:px-10 lg:pl-[12%] lg:pr-[10%] pt-16 sm:pt-28 lg:pt-24 pb-10 sm:pb-12 lg:pb-12"
    >
      <h1
        class="font-nunito font-semibold uppercase text-3xl sm:text-5xl lg:text-7xl text-[#1c4482] leading-tight"
      >
        Referenciación
      </h1>

      <p class="mt-6 sm:mt-8 max-w-5xl text-base sm:text-xl lg:text-2xl text-gray-900 leading-relaxed">
        Como parte de nuestro mejoramiento continuo, en la Clínica Antioquia realizamos
        referenciaciones comparativas con el objetivo de adoptar mejores prácticas que generen
        mayores resultados en los procesos y contribuyan a la satisfacción de los diferentes
        públicos de interés.<br />
        Si deseas hacer una referenciación comparativa en nuestra institución
      </p>

      <a
        href={FORMULARIO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 sm:mt-8 inline-flex items-center justify-center rounded-full bg-[#14438f] px-8 sm:px-12 py-3.5 sm:py-4 font-nunito text-base sm:text-xl lg:text-2xl font-semibold uppercase text-white shadow-sm transition-colors hover:bg-[#0e3270] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2990cb]"
      >
        Completa este formulario
      </a>
    </div>
  </main>
</Layout>
