---
import Layout from "../../layouts/Layout.astro";

const BASE = "/atencion-centrada-persona/ingresa-a-tu-mascota";
// TODO: reemplazar por el enlace real del formulario cuando esté disponible
const SOLICITUD_URL = "#";

// Las fotos traen márgenes transparentes; width/left/top (en % del contenedor)
// recortan la imagen al área visible.
interface Crop {
  src: string;
  alt: string;
  width: number;
  left: number;
  top: number;
}

const circulos: Crop[] = [
  { src: "img-ingresa-a-tu-mascota-13.webp", alt: "Personal de la Clínica abrazando a la perrita terapeuta", width: 120, left: -9.2, top: -16.9 },
  { src: "img-ingresa-a-tu-mascota-14.webp", alt: "Perrita terapeuta sentada junto a un escritorio", width: 111.8, left: -4.1, top: -30.3 },
  { src: "img-ingresa-tu-mascota-3.webp", alt: "Perrita terapeuta junto a una visitante", width: 111.3, left: -4.3, top: -2.1 },
];

const fotoVisita: Crop = {
  src: "img-ingresa-a-tu-mascota-12.webp",
  alt: "Dos colaboradoras de la Clínica con la perrita terapeuta",
  width: 121.6,
  left: -12.5,
  top: -16,
};

const fotoPaciente: Crop = {
  src: "img-ingresa-a-tu-mascota-11.webp",
  alt: "Perrita terapeuta saludando con su pata a una paciente",
  width: 127.4,
  left: -16.9,
  top: -16.1,
};

const perros = [
  "Rabia: vigente según el carné de vacunación.",
  "Vacuna múltiple canina (DHPPi/DAPP): última dosis aplicada dentro de los últimos 12 meses.",
  "Leptospirosis: dentro de los últimos 12 meses.",
  "Bordetella: dentro de los últimos 12 meses.",
];

const gatos = [
  "Rabia: vigente según el esquema certificado.",
  "Triple felina (FVRCP): aplicada dentro de los últimos 12 meses.",
  "Leucemia felina: vigente según indicación veterinaria.",
];

const supervision = [
  "Permanecer con collar y correa.",
  "Estar siempre bajo la supervisión de la persona responsable que la acompaña.",
  "Permanecer únicamente en el espacio autorizado para la visita",
];

const comportamientos = [
  "Agresividad.",
  "Ansiedad intensa.",
  "Ladridos persistentes.",
  "Intentos de morder.",
  "Comportamiento difícil de controlar.",
];

// Huellas decorativas del fondo (según el mock). x / y = centro de la huella en % del
// ancho / alto de la página; las de los bordes quedan recortadas por el overflow-hidden.
const HUELLA = encodeURI(`${BASE}/icon-guia para mascotas.webp`);
const huellas = [
  { x: 5, y: 8 },
  { x: 88, y: 6 },
  { x: 83, y: 11 },
  { x: 2, y: 15 },
  { x: 52, y: 18 },
  { x: 3, y: 25 },
  { x: 94, y: 24 },
  { x: 97, y: 33 },
  { x: 81, y: 37 },
  { x: 4, y: 39 },
  { x: 4, y: 46 },
  { x: 56, y: 46 },
  { x: 96, y: 45 },
  { x: 59, y: 58 },
  { x: 96, y: 59 },
  { x: 3, y: 61 },
  { x: 70, y: 65 },
  { x: 97, y: 71 },
  { x: 4, y: 73 },
  { x: 81, y: 75 },
  { x: 5, y: 84 },
  { x: 81, y: 85 },
  { x: 97, y: 89 },
  { x: 5, y: 96 },
];

const sectionTitle ="font-nunito font-bold text-3xl sm:text-4xl text-[#2990cb]";
const itemTitle = "font-nunito font-bold text-xl sm:text-2xl text-[#2990cb]";
const bodyText = "mt-2 text-base sm:text-lg text-gray-900 leading-relaxed";
const listClass = "mt-2 ml-5 list-disc space-y-1 text-base sm:text-lg text-gray-900 leading-relaxed";
---

<Layout
  title="Ingresa a tu mascota | Clínica Antioquia"
  description="Conoce las recomendaciones para recibir la visita de tu mascota durante la estancia en Clínica Antioquia."
>
  <main class="relative w-full bg-white overflow-hidden">
    <!-- Huellas decorativas de fondo -->
    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
      {huellas.map((h) => (
        <img
          src={HUELLA}
          alt=""
          loading="lazy"
          class="absolute w-[clamp(90px,10vw,190px)] max-w-none h-auto -translate-x-1/2 -translate-y-1/2"
          style={`left:${h.x}%;top:${h.y}%`}
        />
      ))}
    </div>

    <div class="relative z-10 w-full max-w-4xl mx-auto px-6 sm:px-10 py-8 sm:py-12 lg:py-14">

      <!-- Encabezado -->
      <h1 class="font-nunito font-extrabold text-4xl sm:text-5xl lg:text-6xl text-[#1c4482] text-center leading-tight">
        Huellas que nos acompañan
      </h1>

      <ul class="mt-8 sm:mt-10 flex justify-center gap-3 sm:gap-6">
        {circulos.map((foto) => (
          <li class="relative aspect-square w-1/3 max-w-52 overflow-hidden rounded-full border-4 sm:border-8 border-[#3b94d1] box-content">
            <img
              src={`${BASE}/${foto.src}`}
              alt={foto.alt}
              class="absolute max-w-none h-auto"
              style={`width:${foto.width}%;left:${foto.left}%;top:${foto.top}%`}
            />
          </li>
        ))}
      </ul>

      <p class="mt-10 sm:mt-14 text-base sm:text-lg lg:text-xl text-gray-900 leading-relaxed">
        Durante su estancia, usted puede recibir la visita de su mascota.<br />
        Para garantizar una visita segura y tranquila para el paciente, la mascota y el personal
        de la Clínica, tenga en cuenta las siguientes recomendaciones:
      </p>

      <a
        href={SOLICITUD_URL}
        class="mt-6 inline-flex items-center justify-center rounded-full bg-[#1c4482] px-8 py-3 font-nunito text-lg sm:text-2xl font-bold text-white shadow-sm transition-colors hover:bg-[#15335f] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2990cb]"
      >
        Déjanos tu solicitud
      </a>

      <!-- Antes de ingresar -->
      <section class="mt-12 sm:mt-16">
        <h2 class={sectionTitle}>Antes de ingresar a la Clínica</h2>

        <div class="mt-8">
          <h3 class={itemTitle}>1. Carné de vacunación</h3>
          <p class={bodyText}>
            La mascota debe contar con su carné de vacunación vigente. Las vacunas requeridas deben
            tener una vigencia no mayor a un año, de acuerdo con el esquema de vacunación
            correspondiente.
          </p>

          <h4 class="mt-6 font-nunito font-bold text-xl sm:text-2xl text-[#2990cb]">Perros:</h4>
          <ul class={listClass}>
            {perros.map((item) => <li>{item}</li>)}
          </ul>

          <h4 class="mt-6 font-nunito font-bold text-xl sm:text-2xl text-[#2990cb]">Gatos:</h4>
          <ul class={listClass}>
            {gatos.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="mt-10">
          <h3 class={itemTitle}>2. Desparasitación</h3>
          <p class={bodyText}>
            La mascota debe contar con su carné de vacunación vigente. Las vacunas requeridas deben
            tener una vigencia no mayor a un año, de acuerdo con el esquema de vacunación
            correspondiente.
          </p>
        </div>

        <div class="mt-10">
          <h3 class={itemTitle}>3. Higiene</h3>
          <p class={bodyText}>
            La mascota debe estar limpia y haber sido bañada entre 24 y 72 horas antes de la visita.
          </p>
        </div>

        <div class="relative mt-10 mx-auto w-full max-w-lg aspect-[1645/1060] overflow-hidden">
          <img
            src={`${BASE}/${fotoVisita.src}`}
            alt={fotoVisita.alt}
            loading="lazy"
            class="absolute max-w-none h-auto"
            style={`width:${fotoVisita.width}%;left:${fotoVisita.left}%;top:${fotoVisita.top}%`}
          />
        </div>
      </section>

      <!-- Durante la visita -->
      <section class="mt-12 sm:mt-16">
        <h2 class={sectionTitle}>Durante la visita</h2>

        <div class="mt-8">
          <h3 class={itemTitle}>4. Horarios de visita</h3>

          <h4 class="mt-5 font-nunito font-bold text-xl sm:text-2xl text-[#2990cb]">Hospitalización</h4>
          <p class="mt-1 text-lg sm:text-2xl text-gray-900 leading-relaxed">
            Lunes a viernes: 7:30 a. m. a 4:00 p. m.<br />
            Sábados: 8:00 a. m. a 11:30 a. m.
          </p>

          <h4 class="mt-5 font-nunito font-bold text-xl sm:text-2xl text-[#2990cb]">UCI / UCE</h4>
          <p class="mt-1 text-lg sm:text-2xl text-gray-900 leading-relaxed">
            10:00 a. m. a 11:00 a. m. (ingreso)<br />
            11:00 a. m. a 12:00 m. (Ingreso)<br />
            2:00 p. m. a 3:00 p. m. (Ingreso)<br />
            3:00 p. m. a 4:00 p. m. (Ingreso)
          </p>
        </div>

        <div class="mt-10">
          <h3 class={itemTitle}>5. Higiene de manos</h3>
          <p class={bodyText}>Realice higiene de manos antes y después de la visita.</p>
        </div>

        <div class="mt-10">
          <h3 class={itemTitle}>6. Control y supervisión</h3>
          <p class={bodyText}>
            Su mascota no debe deambular por los corredores ni por las demás instalaciones de la
            Clínica.
          </p>
          <p class="mt-4 font-semibold text-[#1c4482] text-base sm:text-lg">Durante toda la visita debe:</p>
          <ul class={listClass}>
            {supervision.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="mt-10">
          <h3 class={itemTitle}>7. Necesidades fisiológicas</h3>
          <p class={bodyText}>
            Procure que su mascota haya realizado sus necesidades antes de ingresar a la Clínica. La
            Institución no se hace responsable de recoger y limpiar las heces y la orina de esta.
          </p>
        </div>

        <div class="mt-10">
          <h3 class={itemTitle}>8. Cuidado de dispositivos médicos</h3>
          <p class={bodyText}>
            Durante la visita, cuide los dispositivos médicos del paciente y evite que la mascota los
            lama, muerda o retire accidentalmente.
          </p>
        </div>

        <div class="mt-10">
          <h3 class={itemTitle}>9. Evite el contacto con otros elementos</h3>
          <p class={bodyText}>
            La mascota no debe tener contacto con otros pacientes, mascotas ni equipos médicos.
          </p>
        </div>

        <div class="mt-10">
          <h3 class={itemTitle}>10. Alimentos y bebidas</h3>
          <p class={bodyText}>
            Durante la permanencia en la Clínica, no suministre alimentos ni bebidas a la mascota,
            salvo indicación expresa del personal de la Clínica.
          </p>
        </div>

        <div class="mt-10">
          <h3 class={itemTitle}>11. Comportamiento de la mascota</h3>
          <p class={bodyText}>
            La visita podrá finalizarse si la mascota presenta un comportamiento que represente un
            riesgo para el paciente, el personal, otras personas o la propia mascota.<br />
            Esto incluye, entre otros:
          </p>
          <ul class={`${listClass} ml-8`}>
            {comportamientos.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>

      <!-- Cierre -->
      <section class="mt-14 sm:mt-20">
        <div class="rounded-3xl bg-sky-100 px-6 py-8 sm:px-12 sm:py-10 text-center text-base sm:text-lg lg:text-xl leading-relaxed text-gray-900">
          <p>
            Una visita que también ayuda a sanar<br />
            Esperamos que la visita de su mascota sea una experiencia positiva y contribuya al
            bienestar emocional y recuperación del paciente.
          </p>
          <p class="mt-4 font-bold text-[#1c4482]">
            Gracias por seguir estas recomendaciones y ayudarnos a mantener un ambiente seguro y
            tranquilo para todos.
          </p>
        </div>

        <div class="relative mt-8 mx-auto w-full max-w-xl aspect-[1570/1230] overflow-hidden">
          <img
            src={`${BASE}/${fotoPaciente.src}`}
            alt={fotoPaciente.alt}
            loading="lazy"
            class="absolute max-w-none h-auto"
            style={`width:${fotoPaciente.width}%;left:${fotoPaciente.left}%;top:${fotoPaciente.top}%`}
          />
        </div>
      </section>
    </div>
  </main>
</Layout>
