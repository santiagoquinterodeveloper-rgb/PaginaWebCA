---
import Layout from "../../layouts/Layout.astro";

const BASE = "/pacientes-visitantes/resultados-en-linea";
const RESULTADOS_URL = "https://resultados.clinicantioquia.com.co/login#/login";
---

<Layout
  title="Resultados en línea | Clínica Antioquia"
  description="Consulta tus resultados en línea de Clínica Antioquia con tu número de estudio."
>
  <main class="relative w-full overflow-hidden bg-white">
    <div
      class="relative mx-auto grid w-full max-w-[1600px] grid-cols-1 items-center gap-10 px-6 py-10 sm:px-10 sm:py-14 lg:grid-cols-2 lg:gap-8 lg:px-[6%] lg:py-16"
    >
      <!-- Columna izquierda: texto -->
      <div class="relative lg:pb-56">
        <h1
          class="font-nunito text-5xl font-extrabold leading-[1.05] text-[#203f8c] sm:text-6xl lg:text-7xl xl:text-8xl"
        >
          Resultados<br />en Línea
        </h1>

        <h2 class="mt-6 font-nunito text-xl font-semibold text-[#3b94d1] sm:text-2xl lg:mt-8 lg:text-3xl xl:text-4xl">
          ¿Cómo consultar tus resultados?
        </h2>

        <p class="mt-6 font-nunito text-lg leading-snug text-black sm:text-2xl lg:mt-10 lg:text-3xl xl:text-4xl">
          Con el número de estudio:<br />
          Haz clic en <strong class="font-semibold text-[#203f8c]">“Ingresar”</strong> para consultar tus resultados
          en línea.
        </p>
        <!-- Flecha decorativa (solo desktop): baja bajo el texto hacia el botón -->
        <img
          src={`${BASE}/icon-01.png`}
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute bottom-0 left-[40%] hidden w-[50%] rotate-45 lg:block"
        />
      </div>

      <!-- Columna derecha: tarjeta de login + botón -->
      <div class="mx-auto flex w-full max-w-md flex-col items-center lg:max-w-[560px]">
        <img
          src={`${BASE}/img-resultados-en-linea-07.png`}
          alt="Formulario de resultados en línea: tipo de documento, número de documento y número de estudio"
          class="h-auto w-full"
          loading="eager"
        />

        <a
          href={RESULTADOS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex w-[80%] items-center justify-center rounded-xl bg-[#203f8c] px-8 py-3 font-nunito text-2xl font-semibold text-white shadow-sm transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#203f8c] sm:text-3xl lg:text-4xl"
        >
          Ingresar
        </a>
      </div>
    </div>
  </main>
</Layout>
