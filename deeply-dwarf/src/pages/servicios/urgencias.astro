---
import Layout from "../../layouts/Layout.astro";
import ServiceHero from "../../components/servicios/ServiceHero.astro";
---

<Layout title="Urgencias | Clínica Antioquia">
  <main class="min-h-screen">
    <ServiceHero
      title="Urgencias"
      cornerImage="/servicios/img-urgencias.png"
      directedTo="Paciente adulto y pediátrico"
      locations={[
        {
          nombre: "Sede Itagüí",
          detalle: "(41 camillas de observacion y 20 sillas)",
        },
      ]}
      features={[
        {
          texto:
            "Clínica Antioquia cuenta para la sede Itagüí con 37 camillas de observación para pacientes adultos, 4 camillas para pacientes pediátricos y 20 sillas para el ambiente de transición",
        },
        {
            texto:
            "Nuestro servicio es de mediana complejidad y contamos con un grupo de profesionales entre enfermeros y especialistas clínicos y quirúrgicos liderados por especialista en urgenciología",
        },
      ]}
    />
  </main>
</Layout>
