---
interface Props {
  icon: string;
  text: string;
}

const { icon, text } = Astro.props;
---

<div class="flex items-center gap-3.5 sm:gap-4">
  <img
    src={icon}
    alt=""
    aria-hidden="true"
    class="h-13 w-13 sm:h-16 sm:w-16 md:h-25 md:w-25 shrink-0 object-contain"
  />
  <span class="font-['Nunito'] text-[#003085] text-base sm:text-lg md:text-xl font-bold leading-snug">
    {text}
  </span>
</div>
