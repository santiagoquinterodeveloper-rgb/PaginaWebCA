---
import logo from '../assets/logo.png';
import searchIcon from '../assets/iconos pagina web-04.png';
import DropdownMenu from './DropdownMenu.astro';

// ---------------------------------------------------------------------------
// Estructura de navegación
// Cada enlace puede tener `items` con submenú (dropdown).
// ---------------------------------------------------------------------------

const nosotrosItems = [
  { title: 'Misión, visión y valores', link: '/nosotros/mission-vision-page' },
  { title: 'Propósito superior', link: '/nosotros/proposito-superior' },
  { title: 'Línea de transparencia', link: '/nosotros/linea-de-transparencia' },
  { title: 'Informes anuales', link: '/nosotros/informes-anuales' },
  /*{ title: 'Reconocimientos', link: '/nosotros/reconocimientos' },*/
  { title: 'Trabaja con nosotros', link: '/nosotros/trabaja-con-nosotros' },
  { title: 'Órganos directivos', link: '/nosotros/organos-directivos' },
  { title: 'Aliados', link: '/nosotros/aliados' },
  { title: 'Referencia', link: '/nosotros/referencia' },
  { title: 'Sedes', link: '/nosotros/sedes' },
];

const serviciosItems = [
  { title: 'Hospitalización', link: '/servicios/hospitalizacion' },
  { title: 'UCI - UCE Adultos', link: '/servicios/uci-uce-adultos' },
  { title: 'Urgencias', link: '/servicios/urgencias' },
  { title: 'Cirugía', link: '/servicios/cirugia' },
  { title: 'Consulta médica especializada', link: '/servicios/consulta-medica-especializada' },
  { title: 'Imágenes diagnósticas', link: '/servicios/imagenes-diagnosticas' },
  { title: 'Laboratorio clínico', link: '/servicios/laboratorio-clinico' },
];  

const pacienteItems = [
  { title: 'Resultados en línea', link: '/paciente-y-visitantes/resultados-en-linea' },
  /*{ title: 'Información para pacientes', link: '/paciente-y-visitantes/informacion-de-pacientes' },*/
  { title: 'Solicita una cotización', link: '/paciente-y-visitantes/solicita-una-cotizacion' },
  { title: 'Horarios de atención', link: '/paciente-y-visitantes/horarios-de-atencion' },
  { title: 'Gestión de PQRS', link: '/paciente-y-visitantes/gestion-de-pqrs' },
  /*{ title: 'Preparate para tu examen', link: '/paciente-y-visitantes/preparate-para-tu-examen' },*/
  /*{ title: 'Entrega de historia clínica', link: '/paciente-y-visitantes/entrega-de-historia-clinica' },*/
  { title: 'Derechos y deberes', link: '/paciente-y-visitantes/derechos-y-deberes' },
];

const atencionCentradaEnLaPersonaItems = [
  { title: 'Conocénos', link: '/atencion-centrada-en-la-persona/conocenos' },
  { title: 'Asociación de usuarios', link: '/atencion-centrada-en-la-persona/asociacion-de-usuarios' }, 
  { title: 'Guía de pacientes y visitantes', link: '/atencion-centrada-en-la-persona/guia-de-pacientes-y-visitantes' },
  { title: 'Participación ciudadana', link: '/atencion-centrada-en-la-persona/participacion-ciudadana' }, 
  { title: 'Ingresa tu mascota', link: '/atencion-centrada-en-la-persona/ingresa-tu-mascota' }, 
  { title: 'Conectar para cuidar', link: '/atencion-centrada-en-la-persona/conectar-para-cuidar' }, 
  /*{ title: 'Sala de lactancia', link: '/atencion-centrada-en-la-persona/sala-de-lactancia' },*/
];

const navLinks = [
  { label: 'Inicio',               href: '/',                    items: null },
  { label: 'Nosotros',             href: '/nosotros',             items: nosotrosItems },
  { label: 'Servicios',            href: '/servicios',            items: serviciosItems },
  { label: 'Paciente y visitantes',href: '/paciente-y-visitantes',items: pacienteItems },
  { label: 'Atención centrada en la persona', href: '/atencion-centrada-en-la-persona', items: atencionCentradaEnLaPersonaItems }, 
  { label: 'Pagos en línea', href: 'https://checkout.wompi.co/l/zyGHYR', items: null },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full bg-white shadow-sm">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8"
    aria-label="Navegación principal"
  >
    <!-- Logo -->
    <a href="/" class="flex shrink-0 items-center" aria-label="Clínica Antioquia – Inicio">
      <img
        src={logo.src}
        alt="Clínica Antioquia"
        width="180"
        height="60"
        class="h-12 w-auto object-contain"
        loading="eager"
      />
    </a>

    <!-- Desktop navigation -->
    <ul class="hidden items-center gap-1 lg:flex" role="list">
      {
        navLinks.map((link) => {
          const hasDropdown = link.items && link.items.length > 0;
          const isActive = currentPath === link.href || currentPath.startsWith(link.href + '/');

          return (
            <li class:list={['relative', hasDropdown && 'group']}>
              {hasDropdown ? (
                /*
                  Elemento con submenú: usamos un <button> que activa el dropdown
                  vía CSS (group-hover / group-focus-within).
                  El botón expone aria-haspopup y aria-expanded.
                  Nota: aria-expanded se gestiona con JS para foco de teclado.
                */
                <button
                  type="button"
                  class:list={[
                    'font-nunito flex items-center gap-1 rounded-md px-3 py-2 text-sm font-semibold',
                    'transition-colors duration-150 hover:bg-gray-100',
                    isActive ? 'text-brand' : 'text-gray-700 hover:text-brand',
                  ]}
                  aria-haspopup="true"
                  aria-expanded="false"
                  data-dropdown-trigger
                >
                  {link.label}
                  <!-- Chevron -->
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3.5 w-3.5 shrink-0 transition-transform duration-150 group-hover:rotate-180"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <DropdownMenu items={link.items!} />
              ) : (
                <a
                  href={link.href}
                  class:list={[
                    'font-nunito rounded-md px-3 py-2 text-sm font-semibold transition-colors duration-150 hover:bg-gray-100',
                    isActive ? 'text-brand' : 'text-gray-700 hover:text-brand',
                  ]}
                  aria-current={currentPath === link.href ? 'page' : undefined}
                >
                  {link.label}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>

    <!-- Desktop right actions -->
    <div class="hidden items-center gap-4 lg:flex">
      <!-- Search -->
      <button
        type="button"
        class="flex items-center justify-center rounded-full p-2 text-gray-600 transition-colors duration-150 hover:bg-gray-100 hover:text-brand focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
        aria-label="Buscar"
        id="btn-search"
      >
        <img
          src={searchIcon.src}
          alt=""
          aria-hidden="true"
          width="22"
          height="22"
          class="h-6 w-6 object-contain"
        />
      </button>

      <!-- CTA -->
      <a
        href="/agenda-tu-cita"
        class="font-nunito inline-flex items-center rounded-full bg-brand px-5 py-2.5 text-sm font-bold text-white shadow-sm transition-opacity duration-150 hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand focus-visible:outline-offset-2"
        id="cta-agenda"
      >
        Agenda tu cita
      </a>
    </div>

    <!-- Mobile right actions (search + menu) -->
    <div class="flex items-center gap-1 lg:hidden">
      <!-- Mobile search button -->
      <button
        type="button"
        class="inline-flex items-center justify-center rounded-md p-2 text-gray-700 transition-colors hover:bg-gray-100 hover:text-brand focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
        aria-label="Buscar"
        id="btn-search-mobile"
      >
        <img
          src={searchIcon.src}
          alt=""
          aria-hidden="true"
          width="22"
          height="22"
          class="h-6 w-6 object-contain"
        />
      </button>

    <!-- Mobile menu button -->
    <button
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-gray-700 transition-colors hover:bg-gray-100 hover:text-brand focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Abrir menú de navegación"
      id="btn-menu-toggle"
    >
      <!-- Hamburger icon -->
      <svg
        id="icon-menu-open"
        class="block h-6 w-6"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.75"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <!-- Close icon -->
      <svg
        id="icon-menu-close"
        class="hidden h-6 w-6"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.75"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-gray-100 lg:hidden"
    role="navigation"
    aria-label="Menú móvil"
  >
    <ul class="flex flex-col py-2" role="list">
      {
        navLinks.map((link) => {
          const hasDropdown = link.items && link.items.length > 0;
          const isActive = currentPath === link.href || currentPath.startsWith(link.href + '/');

          return (
            <li>
              {hasDropdown ? (
                /* Accordion item para mobile */
                <div class="mobile-accordion-item">
                  <button
                    type="button"
                    class:list={[
                      'font-nunito flex w-full items-center justify-between px-6 py-3 text-base font-semibold',
                      'transition-colors duration-150 hover:bg-gray-50',
                      isActive ? 'text-brand' : 'text-gray-700',
                    ]}
                    aria-expanded="false"
                    aria-controls={`mobile-sub-${link.href.replace(/\//g, '-')}`}
                    data-mobile-accordion-trigger
                  >
                    <span>{link.label}</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 shrink-0 transition-transform duration-200"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="2.5"
                      stroke="currentColor"
                      aria-hidden="true"
                      data-chevron
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  <!-- Submenú expandible -->
                  <ul
                    id={`mobile-sub-${link.href.replace(/\//g, '-')}`}
                    class="hidden flex-col border-t border-gray-100 bg-gray-50"
                    role="list"
                  >
                    {link.items!.map((item) => (
                      <li class="border-b border-gray-100 last:border-b-0">
                        <a
                          href={item.link}
                          class="font-poppins flex items-center justify-between px-8 py-2.5 text-sm text-gray-600 transition-colors hover:text-brand"
                        >
                          <span>{item.title}</span>
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-3.5 w-3.5 shrink-0 text-brand opacity-60"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            aria-hidden="true"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                          </svg>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <a
                  href={link.href}
                  class:list={[
                    'font-nunito block px-6 py-3 text-base font-semibold transition-colors duration-150',
                    'hover:bg-gray-50',
                    isActive ? 'text-brand' : 'text-gray-700 hover:text-brand',
                  ]}
                  aria-current={currentPath === link.href ? 'page' : undefined}
                >
                  {link.label}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>

    <div class="border-t border-gray-100 px-4 py-4">
      <a
        href="/agenda-tu-cita"
        class="font-nunito flex w-full items-center justify-center rounded-full bg-brand px-5 py-3 text-sm font-bold text-white shadow-sm transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand focus-visible:outline-offset-2"
      >
        Agenda tu cita
      </a>
    </div>
  </div>
</header>

<script>
  // ─── Mobile: menú principal ──────────────────────────────────────────────
  const toggleBtn = document.getElementById('btn-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-menu-open');
  const iconClose = document.getElementById('icon-menu-close');

  function closeMobileMenu() {
    mobileMenu?.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    toggleBtn?.setAttribute('aria-label', 'Abrir menú de navegación');
  }

  toggleBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      closeMobileMenu();
    } else {
      mobileMenu?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
    }
  });

  // ─── Mobile: accordion de submenús ──────────────────────────────────────
  const accordionTriggers = document.querySelectorAll<HTMLButtonElement>(
    '[data-mobile-accordion-trigger]'
  );

  accordionTriggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const controlsId = trigger.getAttribute('aria-controls');
      if (!controlsId) return;

      const submenu = document.getElementById(controlsId);
      if (!submenu) return;

      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
      const chevron = trigger.querySelector('[data-chevron]');

      if (isExpanded) {
        submenu.classList.add('hidden');
        submenu.classList.remove('flex');
        trigger.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('rotate-180');
      } else {
        submenu.classList.remove('hidden');
        submenu.classList.add('flex');
        trigger.setAttribute('aria-expanded', 'true');
        chevron?.classList.add('rotate-180');
      }
    });
  });

  // ─── Cerrar menú y submenús con Escape ──────────────────────────────────
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
        closeMobileMenu();
        toggleBtn?.focus();
      }
    }
  });

  // ─── Abrir modal de búsqueda (desktop + mobile) ─────────────────────────
  function openSearch() {
    // Si el menú móvil está abierto, lo cerramos para no superponer modales.
    if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
      closeMobileMenu();
    }
    document.dispatchEvent(new CustomEvent('open-search'));
  }

  document.getElementById('btn-search')?.addEventListener('click', openSearch);
  document.getElementById('btn-search-mobile')?.addEventListener('click', openSearch);

  // Atajo "/" para abrir la búsqueda (desktop).
  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement | null;
    const isTyping =
      target &&
      (target.tagName === 'INPUT' ||
        target.tagName === 'TEXTAREA' ||
        target.isContentEditable);
    if (e.key === '/' && !isTyping) {
      e.preventDefault();
      openSearch();
    }
  });

  // ─── Desktop: sincronizar aria-expanded con hover/focus ─────────────────
  // El panel aparece por CSS, pero actualizamos el atributo para accesibilidad
  const desktopTriggers = document.querySelectorAll<HTMLButtonElement>(
    '[data-dropdown-trigger]'
  );

  desktopTriggers.forEach((trigger) => {
    const li = trigger.closest('li');
    if (!li) return;

    li.addEventListener('mouseenter', () => {
      trigger.setAttribute('aria-expanded', 'true');
    });
    li.addEventListener('mouseleave', () => {
      trigger.setAttribute('aria-expanded', 'false');
    });
    li.addEventListener('focusin', () => {
      trigger.setAttribute('aria-expanded', 'true');
    });
    li.addEventListener('focusout', (e) => {
      if (!li.contains((e as FocusEvent).relatedTarget as Node)) {
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
