---
// FloralBackground.astro
// Elemento decorativo: flor gigante tenue distribuida en el background de la página
---

<!-- Flor 1: Superior derecha (detrás de carrusel / accesos) -->
<div 
  class="pointer-events-none select-none absolute top-4 -right-24 sm:-right-36 lg:-right-48 w-[480px] sm:w-[700px] lg:w-[950px] opacity-[0.25] z-0 overflow-hidden"
  aria-hidden="true"
>
  <img
    src="/trabaja-con-nosotros/florGigante.png"
    alt=""
    class="w-full h-auto object-contain block"
  />
</div>

<!-- Flor 2: Central izquierda (detrás de Nuestros Servicios) -->
<div 
  class="pointer-events-none select-none absolute top-[26%] -left-28 sm:-left-44 lg:-left-56 w-[450px] sm:w-[650px] lg:w-[900px] opacity-[0.22] z-0"
  aria-hidden="true"
>
  <img
    src="/trabaja-con-nosotros/florGigante.png"
    alt=""
    class="w-full h-auto object-contain block"
  />
</div>

<!-- Flor 3: Derecha (detrás de Trabaja con nosotros) -->
<div 
  class="pointer-events-none select-none absolute top-[55%] -right-28 sm:-right-44 lg:-right-56 w-[450px] sm:w-[650px] lg:w-[900px] opacity-[0.24] z-0"
  aria-hidden="true"
>
  <img
    src="/trabaja-con-nosotros/florGigante.png"
    alt=""
    class="w-full h-auto object-contain block"
  />
</div>

<!-- Flor 4: Inferior izquierda (detrás de Información legal) -->
<div 
  class="pointer-events-none select-none absolute top-[80%] -left-24 sm:-left-36 lg:-left-48 w-[400px] sm:w-[580px] lg:w-[800px] opacity-[0.24] z-0"
  aria-hidden="true"
>
  <img
    src="/trabaja-con-nosotros/florGigante.png"
    alt=""
    class="w-full h-auto object-contain block"
  />
</div>

