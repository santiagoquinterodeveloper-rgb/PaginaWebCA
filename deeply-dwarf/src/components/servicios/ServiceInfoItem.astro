---
interface Props {
  icon: string;
  text: string;
}

const { icon, text } = Astro.props;
---

<div class="flex items-center">
  <img
    src={icon}
    alt=""
    aria-hidden="true"
    class="h-16 w-16 sm:h-20 sm:w-20 lg:h-24 lg:w-24 -my-3 shrink-0 object-contain"
  />
  <span class="max-w-[9.5em] font-['Nunito'] text-black text-base sm:text-lg lg:text-2xl font-medium leading-snug">
    {text}
  </span>
</div>
