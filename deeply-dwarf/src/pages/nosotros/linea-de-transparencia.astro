---
import Layout from "../../layouts/Layout.astro";
import ContactPill from "../../components/ui/contact-pill.astro";
---

<Layout
  title="Línea de Transparencia | Clínica Antioquia"
  description="Línea de Transparencia de la Clínica Antioquia. Un canal seguro y confidencial para comunicar situaciones que puedan ir en contra de nuestros valores, principios o normas institucionales."
>
  <main
    class="relative w-full bg-white min-h-[calc(100vh-80px)] flex flex-col justify-between py-10 sm:py-14 lg:py-16 overflow-hidden"
  >
    <!-- Imagen de fondo (img-02.webp) con tratamiento tenue para legibilidad -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <img
        src="/linea-transparencia/img-02.webp"
        alt=""
        aria-hidden="true"
        class="w-full h-full object-cover object-center opacity-40 filter contrast-105"
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-white/70 via-white/50 to-white/90"
      >
      </div>
    </div>

    <!-- Contenedor principal del contenido de la página -->
    <div
      class="relative z-10 w-full max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-12 my-auto"
    >
      <!-- 1. Sección superior (Composición fotográfica a la izquierda + Textos a la derecha) -->
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center"
      >
        <!-- Lado izquierdo: Fotografía de la mujer con círculo azul (#003085) sobresaliendo detrás -->
        <div class="lg:col-span-5 flex justify-center items-center">
          <div
            class="relative flex items-center justify-center max-w-[340px] sm:max-w-[420px] lg:max-w-[460px] w-full"
          >
            <!-- Círculo azul principal (#003085) detrás, sobresaliendo por la izquierda -->
            <div
              class="absolute left-[5px] sm:left-[-5px] lg:left-[-15px] top-1/2 -translate-y-1/2 w-[290px] h-[290px] sm:w-[370px] sm:h-[370px] lg:w-[410px] lg:h-[410px] rounded-full bg-[#003085] z-0 shadow-lg"
            >
            </div>

            <!-- Imagen de la mujer en primer plano -->
            <div class="relative z-10 w-full">
              <img
                src="/linea-transparencia/img-01.webp"
                alt="Línea de Transparencia - Colaboradora Clínica Antioquia"
                class="w-full h-auto object-contain block"
              />
            </div>
          </div>
        </div>

        <!-- Lado derecho: Título principal y párrafos institucionales -->
        <div
          class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left space-y-5 sm:space-y-6 lg:space-y-7"
        >
          <!-- Título principal "LINEA DE TRANSPARENCIA" -->
          <div class="w-full">
            <h1
              class="font-['Nunito'] font-extrabold uppercase text-3xl sm:text-4xl lg:text-[46px] leading-[1.15] tracking-tight"
            >
              <span class="text-[#45a1e6]">LÍNEA </span><span
                class="text-[#003085]">DE</span
              >
              <br />
              <span class="text-[#003085]">TRANSPARENCIA</span>
            </h1>
          </div>

          <!-- Párrafos de texto -->
          <div
            class="max-w-[620px] space-y-4 sm:space-y-5 font-['Poppins'] text-slate-800 text-sm sm:text-base lg:text-[16.5px] leading-relaxed font-normal"
          >
            <p>
              En Clínica Antioquia creemos que la transparencia, la ética, el
              respeto y la responsabilidad son fundamentales para construir
              confianza.
            </p>
            <p>
              Por eso contamos con la Línea de Transparencia, un canal seguro y
              confidencial para comunicar situaciones que puedan ir en contra de
              nuestros valores, principios o normas institucionales.
            </p>
            <p>
              Tu participación nos ayuda a fortalecer una Clínica íntegra,
              confiable y comprometida con el bienestar de las personas.
            </p>
          </div>
        </div>
      </div>

      <!-- 2. Sección inferior: "NUESTROS CANALES DE ATENCIÓN" y ContactPill -->
      <div
        class="mt-14 sm:mt-16 lg:mt-20 flex flex-col items-center text-center space-y-6 sm:space-y-7"
      >
        <!-- Título de canales -->
        <h2
          class="font-['Nunito'] font-extrabold text-[#45a1e6] text-xl sm:text-2xl lg:text-[28px] uppercase tracking-wider"
        >
          NUESTROS CANALES DE ATENCIÓN
        </h2>

        <!-- Componente reutilizable ContactPill -->
        <ContactPill
          icon="/linea-transparencia/icon-01.webp"
          text="transparencia@clinicantioquia.com.co"
          href="mailto:transparencia@clinicantioquia.com.co"
        />
      </div>
    </div>
  </main>
</Layout>
