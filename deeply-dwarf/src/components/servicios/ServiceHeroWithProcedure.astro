---
// Componente ajustado para los servicios que tienen una lista de procedimientos
import ServiceInfoItem from "./ServiceInfoItem.astro";
import ServiceLocationCard from "./ServiceLocationCard.astro";
import ServiceFeatureItemWithProcedures from "./ServiceFeatureItemWithProcedures.astro";

interface LocationData {
  nombre: string;
  detalle: string;
}

interface FeatureData {
  texto: string;
  procedimientos: string[];
}

interface Props {
  title: string;
  cornerImage: string;
  directedTo: string;
  locations: LocationData[];
  features: FeatureData[];
}

const { title, cornerImage, directedTo, locations, features } = Astro.props;

// Grid de features: 1 col por defecto, 2 si hay 2, 3 si hay 3+
const featureGrid =
  features.length === 1
    ? "grid-cols-1"
    : features.length === 2
      ? "grid-cols-1 sm:grid-cols-2"
      : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3";
---

<section class="w-full">
  <!-- Hero: título + imagen esquina + info items -->
  <div class="relative w-full overflow-hidden md:min-h-[340px] lg:min-h-[380px]">
    <!-- Imagen esquina superior derecha (cuarto de círculo) -->
    <div
      class="hidden md:block absolute top-0 right-0 w-[42%] lg:w-[38%] max-w-[480px] aspect-square rounded-bl-full overflow-hidden z-0"
    >
      <img
        src={cornerImage}
        alt=""
        aria-hidden="true"
        class="h-full w-full object-cover object-center"
      />
    </div>

    <!-- Contenido: título + info row + tarjeta sedes -->
    <div class="relative z-10 px-4 sm:px-8 md:px-12 pt-4 sm:pt-6 md:pt-8 pb-6 sm:pb-8 w-full md:max-w-[58%] lg:max-w-[62%]">
      <!-- Título grande -->
      <h1
        class="font-['Nunito'] text-[#003085] font-extrabold text-4xl sm:text-5xl md:text-6xl leading-tight mb-5 sm:mb-6"
      >
        {title}
      </h1>

      <!-- Fila: Dirigido | divisor | Disponible en nuestras sedes -->
      <div class="flex flex-wrap items-center gap-4 sm:gap-6 mb-6">
        <ServiceInfoItem icon="/servicios/icon-2.png" text={`Dirigido: ${directedTo}`} />
        <div class="hidden sm:block w-px self-stretch bg-[#003085] opacity-30 mx-1" aria-hidden="true"></div>
        <ServiceInfoItem icon="/servicios/icon-1.png" text="Disponible en nuestras sedes" />
      </div>

      <!-- Tarjeta azul con sedes -->
      <div class="w-full">
        <ServiceLocationCard locations={locations} />
      </div>
    </div>
  </div>

  <!-- Sección Características del Servicio -->
  <div class="px-4 sm:px-8 md:px-12 py-8">
    <h2
      class="font-['Nunito'] text-[#003085] font-bold text-2xl sm:text-3xl md:text-4xl mb-8 text-center sm:text-left"
    >
      Características del Servicio
    </h2>

    <div class={`grid ${featureGrid} gap-8`}>
      {features.map((feature) => (
        <ServiceFeatureItemWithProcedures texto={feature.texto} procedimientos={feature.procedimientos} />
      ))}
    </div>
  </div>
</section>
