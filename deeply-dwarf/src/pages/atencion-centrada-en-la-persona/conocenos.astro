---
import Layout from "../../layouts/Layout.astro";

const BASE = "/atencion-centrada-persona/conocenos";
const FLOR = `${BASE}/flor-icon-conocenos.webp`;

const polaroids = [
  { src: `${BASE}/img-conocenos (1).webp`, alt: "Colaboradores de Clínica Antioquia con niños en una actividad recreativa", rot: "-rotate-[8deg]", offset: "sm:mt-2" },
  { src: `${BASE}/img-conocenos (2).webp`, alt: "Equipo de Clínica Antioquia haciendo corazones con las manos", rot: "rotate-[3deg]", offset: "sm:mt-8" },
  { src: `${BASE}/img-conocenos.webp`, alt: "Colaboradoras de Clínica Antioquia junto a un perro de terapia", rot: "-rotate-[8deg]", offset: "sm:-mt-1" },
];

const buscamos = [
  { icon: `${BASE}/icon-conocenos (8).webp`, texto: "Humanizar la atención en salud" },
  { icon: `${BASE}/icon-conocenos (9).webp`, texto: "Fortalecer la comunicación y la empatía" },
  { icon: `${BASE}/icon-conocenos (10).webp`, texto: "Promover el respeto y la dignidad" },
  { icon: `${BASE}/icon-conocenos (1).webp`, texto: "Acompañar emocional y socialmente al paciente y su familia" },
];

const equipo = [
  { icon: `${BASE}/icon-conocenos (3).webp`, titulo: "Trabajo Social:", texto: "Orientación y acompañamiento social para pacientes y familias." },
  { icon: `${BASE}/icon-conocenos (4).webp`, titulo: "Psicología", texto: "Apoyo emocional y fortalecimiento del bienestar mental." },
  { icon: `${BASE}/icon-conocenos (5).webp`, titulo: "Administrativos", texto: "Gestión y articulación de procesos para una atención organizada y oportuna." },
  { icon: `${BASE}/icon-conocenos (6).webp`, titulo: "Atención al Usuario", texto: "Orientación, información y gestión de necesidades e inquietudes." },
  { icon: `${BASE}/icon-conocenos (7).webp`, titulo: "Anfitriones", texto: "Recibimiento cálido y guía para usuarios y visitantes." },
];

const atencion = ["Humana", "Empática", "Respetuosa", "Cercana", "Centrada en la persona y su familia"];
---

<Layout
  title="Conócenos | Atención centrada en la persona | Clínica Antioquia"
  description="Conoce el modelo de Atención Centrada en la Persona de Clínica Antioquia: humanización, empatía, respeto y acompañamiento al paciente y su familia."
>
  <main class="relative w-full overflow-hidden bg-white font-nunito text-[#1a1a1a]">
    <!-- ============================================================ -->
    <!-- HERO: Bienvenidos + polaroids                                -->
    <!-- ============================================================ -->
    <section class="relative">
      <img src={FLOR} alt="" aria-hidden="true" class="pointer-events-none absolute -left-24 top-0 hidden w-72 lg:block" />

      <div class="relative mx-auto max-w-6xl px-6 pt-10 pb-12 sm:px-10 lg:pt-14 lg:pb-16">
        <h1 class="text-5xl font-extrabold leading-tight text-[#1f3a73] sm:text-6xl lg:text-7xl">
          Bienvenidos
        </h1>
        <h2 class="text-2xl font-bold leading-tight text-[#3b94d1] sm:text-4xl lg:text-5xl">
          Atención centrada en la persona
        </h2>

        <ul class="mx-auto mt-10 grid max-w-sm grid-cols-1 gap-10 sm:max-w-none sm:grid-cols-3 sm:gap-6 lg:gap-10">
          {polaroids.map((p) => (
            <li class:list={["relative", p.offset]}>
              <div class:list={["relative mx-auto aspect-[4/4.6] w-[88%] max-w-[340px] sm:w-full rounded-[2rem] bg-[#7fb8e3]", p.rot]}>
                <!-- Clip -->
                <svg
                  class="absolute -top-8 left-1/2 w-[28%] -translate-x-1/2"
                  viewBox="0 0 80 110"
                  fill="none"
                  aria-hidden="true"
                >
                  <path d="M22 62 C12 30 20 4 40 4 C60 4 68 30 58 62" stroke="#9aa3b2" stroke-width="5" stroke-linecap="round" />
                  <rect x="4" y="58" width="72" height="46" rx="4" fill="#1f3a73" />
                  <rect x="4" y="94" width="72" height="10" rx="3" fill="#3b7fc4" />
                </svg>
                <img
                  src={p.src}
                  alt={p.alt}
                  class="absolute left-[4%] top-[24%] w-[92%] max-w-none"
                  loading="eager"
                />
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- Porque cada persona merece ser escuchada                     -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden">
      <!-- Fondo: foto difuminada -->
      <img
        src={`${BASE}/img-conocenos (1).webp`}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 h-full w-full scale-125 object-cover blur-2xl"
      />
      <div class="absolute inset-0 bg-[#eef5fb]/85"></div>

      <div class="relative mx-auto max-w-6xl px-6 py-12 sm:px-10 sm:py-16 lg:py-20">
        <h2 class="mx-auto max-w-4xl text-center text-2xl font-bold leading-snug text-[#1f3a73] sm:text-4xl lg:text-5xl">
          Porque cada persona merece ser escuchada, comprendida y acompañada.
        </h2>

        <div class="mx-auto mt-10 max-w-5xl rounded-[2rem] bg-[#c9dcee]/70 px-6 py-8 backdrop-blur-sm sm:rounded-[3rem] sm:px-12 sm:py-12 lg:px-16">
          <div class="space-y-1 text-base leading-snug text-black sm:text-xl lg:text-2xl sm:text-justify">
            <p>En Clínica Antioquia creemos que la atención va más allá de un servicio.</p>
            <p>
              Por eso vivimos una Atención Centrada en la Persona, un modelo que reconoce a cada paciente
              como un ser único, con emociones, necesidades, valores y una historia de vida propia.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- ¿Qué buscamos?                                               -->
    <!-- ============================================================ -->
    <section class="relative">
      <img src={FLOR} alt="" aria-hidden="true" class="pointer-events-none absolute -right-20 top-10 hidden w-80 lg:block" />
      <img src={FLOR} alt="" aria-hidden="true" class="pointer-events-none absolute -left-24 bottom-0 hidden w-80 lg:block" />

      <div class="relative mx-auto max-w-5xl px-6 py-12 sm:px-10 sm:py-16">
        <h2 class="text-center text-4xl font-extrabold text-[#1f3a73] sm:text-5xl lg:text-6xl">
          ¿Qué buscamos?
        </h2>

        <ul class="mt-10 space-y-4 sm:mt-12">
          {buscamos.map((b) => (
            <li class="relative flex items-center rounded-full bg-[#d3e6f4] py-3 pl-[4.75rem] pr-6 sm:min-h-[4.5rem] sm:pl-28 lg:min-h-[5rem]">
              <span class="absolute left-0 top-1/2 flex h-14 w-14 -translate-y-1/2 items-center justify-center rounded-full bg-[#1f3a73] sm:h-[4.5rem] sm:w-[4.5rem] lg:h-[5.5rem] lg:w-[5.5rem]">
                <img src={b.icon} alt="" aria-hidden="true" class="h-[68%] w-[68%] object-contain" loading="lazy" />
              </span>
              <span class="text-base leading-snug sm:text-xl lg:text-2xl">{b.texto}</span>
            </li>
          ))}
          <li class="py-3 pl-[4.75rem] pr-6 text-base leading-snug sm:pl-28 sm:text-xl lg:text-2xl">
            Generar experiencias más cálidas y seguras
          </li>
        </ul>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- Importante                                                   -->
    <!-- ============================================================ -->
    <section class="relative">
      <div class="relative mx-auto max-w-6xl px-6 py-10 sm:px-10 sm:py-14">
        <div class="flex items-center justify-center gap-3 sm:gap-5">
          <img src={`${BASE}/icon-conocenos (2).webp`} alt="" aria-hidden="true" class="h-9 w-9 object-contain sm:h-14 sm:w-14 lg:h-16 lg:w-16" />
          <h2 class="text-4xl font-extrabold text-[#1f3a73] sm:text-5xl lg:text-6xl">Importante</h2>
        </div>

        <div class="mt-8 rounded-[2rem] bg-[#d3e6f4] px-6 py-8 sm:rounded-[3rem] sm:px-12 sm:py-12 lg:px-14">
          <div class="space-y-1 text-base leading-snug text-black sm:text-xl lg:text-2xl sm:text-justify">
            <p>La Atención Centrada en la Persona es diferente al área de Atención al Usuario.</p>
            <p>
              Mientras Atención al Usuario orienta y gestiona solicitudes, la Atención Centrada en la Persona
              acompaña integralmente al paciente y su familia, promoviendo bienestar, escucha activa y
              humanización durante la atención.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- Somos un equipo articulado                                   -->
    <!-- ============================================================ -->
    <section class="relative">
      <img src={FLOR} alt="" aria-hidden="true" class="pointer-events-none absolute -left-24 top-24 hidden w-80 lg:block" />
      <img src={FLOR} alt="" aria-hidden="true" class="pointer-events-none absolute -right-24 bottom-24 hidden w-80 lg:block" />

      <div class="relative mx-auto max-w-5xl px-6 py-12 sm:px-10 sm:py-16">
        <h2 class="mx-auto max-w-2xl text-center text-4xl font-extrabold leading-tight text-[#1f3a73] sm:text-5xl lg:text-6xl">
          Somos un equipo articulado
        </h2>

        <ul class="mx-auto mt-12 max-w-3xl space-y-8 sm:space-y-12">
          {equipo.map((e) => (
            <li class="flex items-center gap-5 sm:gap-10 lg:gap-14">
              <div class="flex w-20 shrink-0 justify-center sm:w-36 lg:w-44">
                <img src={e.icon} alt="" aria-hidden="true" class="h-20 w-20 object-contain sm:h-28 sm:w-28 lg:h-32 lg:w-32" loading="lazy" />
              </div>
              <p class="text-base leading-snug sm:text-xl lg:text-2xl">
                <strong class="block font-bold">{e.titulo}</strong>
                {e.texto}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- Nuestro compromiso                                           -->
    <!-- ============================================================ -->
    <section class="relative">
      <img src={FLOR} alt="" aria-hidden="true" class="pointer-events-none absolute -left-24 top-0 hidden w-80 lg:block" />
      <img src={FLOR} alt="" aria-hidden="true" class="pointer-events-none absolute -right-20 top-10 hidden w-72 lg:block" />
      <img src={FLOR} alt="" aria-hidden="true" class="pointer-events-none absolute bottom-0 left-1/3 hidden w-96 lg:block" />

      <div class="relative mx-auto max-w-5xl px-6 pb-20 pt-10 sm:px-10 sm:pb-28">
        <h2 class="text-center text-4xl font-extrabold text-[#1f3a73] sm:text-5xl lg:text-6xl">
          Nuestro compromiso
        </h2>

        <div class="mx-auto mt-10 max-w-3xl lg:pl-10">
          <p class="text-lg font-bold text-[#3b94d1] sm:text-2xl lg:text-3xl">Trabajamos para ofrecer una atención:</p>
          <ul class="mt-6 list-disc space-y-2 pl-8 text-lg sm:text-2xl lg:text-3xl">
            {atencion.map((a) => <li>{a}</li>)}
          </ul>
        </div>

        <blockquote class="mx-auto mt-16 max-w-4xl text-center text-3xl font-extrabold leading-tight text-[#1f3a73] sm:mt-24 sm:text-5xl lg:text-6xl">
          “Cuidamos personas, no solo pacientes.”
        </blockquote>
      </div>
    </section>
  </main>
</Layout>
